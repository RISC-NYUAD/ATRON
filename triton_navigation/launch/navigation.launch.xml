<?xml version="1.0"?>
<launch>
    <arg name="map" default="$(find-pkg-share triton_navigation)/maps/map_home.yaml"/>
    <arg name="rviz_config" default="$(find-pkg-share triton_navigation)/rviz/navigation.rviz"/>
    <arg name="footprint_file" default="$(find-pkg-share triton_navigation)/config/footprint.yaml"/>
    <arg name="use_sim_time" default="false"/>

    <!-- <node pkg="rviz2" exec="rviz2" name="rviz2" args="-d $(var rviz_config)" output="screen"/> -->

    <node pkg="nav2_map_server" exec="map_server" name="map_server" output="screen">
        <param name="frame_id" value="map"/>
        <param name="topic_name" value="/map"/>
        <param name="yaml_filename" value="$(var map)"/>
    </node>

    <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" name="lifecycle_manager_navigation" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param name="autostart" value="true"/>
        <param name="node_names" value="['map_server']"/>
    </node>

    <node pkg="triton_navigation" exec="path_planning" name="path_planning_node" output="screen">
        <param from="$(var footprint_file)"/>
    </node>
</launch>